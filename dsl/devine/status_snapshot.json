{
  "name": "devine_status_snapshot",
  "dsl_version": 2,
  "description": "workflow status 的只读快照：binary repo 的 VERSION/branch/HEAD/tags + 四个目录内 app 的 FAT /version（app_version + HTTP 状态）。对应 WorkflowStatus（cmd/devine-utils-ci/internal/workflow_status.go）。只读：不触发任何 pipeline，不改任何状态。",
  "start": "probe_test_004",
  "max_iterations": 8,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "policy": {
    "allow_exec": false,
    "allow_hosts": [
      "devine-test-004-function.fws.faas.qa.nt.ctripcorp.com",
      "devine-test-001-function.fws.faas.qa.nt.ctripcorp.com",
      "devine-app-integration-01-function.fws.faas.qa.nt.ctripcorp.com",
      "devine-app-integration-02-function.fws.faas.qa.nt.ctripcorp.com"
    ],
    "max_timeout_ms": 10000,
    "max_output": 65536,
    "retries": 1
  },
  "capabilities": {
    "test_004_version": {
      "kind": "http",
      "method": "GET",
      "url": "http://devine-test-004-function.fws.faas.qa.nt.ctripcorp.com/version",
      "timeout_ms": 10000,
      "expect_json": true
    },
    "test_001_version": {
      "kind": "http",
      "method": "GET",
      "url": "http://devine-test-001-function.fws.faas.qa.nt.ctripcorp.com/version",
      "timeout_ms": 10000,
      "expect_json": true
    },
    "integration_01_version": {
      "kind": "http",
      "method": "GET",
      "url": "http://devine-app-integration-01-function.fws.faas.qa.nt.ctripcorp.com/version",
      "timeout_ms": 10000,
      "expect_json": true
    },
    "integration_02_version": {
      "kind": "http",
      "method": "GET",
      "url": "http://devine-app-integration-02-function.fws.faas.qa.nt.ctripcorp.com/version",
      "timeout_ms": 10000,
      "expect_json": true
    }
  },
  "nodes": [
    {
      "name": "probe_test_004",
      "primary_q": "probed",
      "questions": {
        "probed": {
          "type": "choice",
          "instructions": "读 devine-test-004-function /version。",
          "criteria": {
            "A": "已读",
            "B": "不可访问"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "probe_test_001"
      },
      "action": {
        "kind": "call",
        "capability": "test_004_version",
        "project": {
          "test_004_app_version": "/app_version",
          "test_004_status": "/status"
        }
      }
    },
    {
      "name": "probe_test_001",
      "primary_q": "probed",
      "questions": {
        "probed": {
          "type": "choice",
          "instructions": "读 devine-test-001-function /version。",
          "criteria": {
            "A": "已读",
            "B": "不可访问"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "probe_integration_01"
      },
      "action": {
        "kind": "call",
        "capability": "test_001_version",
        "project": {
          "test_001_app_version": "/app_version",
          "test_001_status": "/status"
        }
      }
    },
    {
      "name": "probe_integration_01",
      "primary_q": "probed",
      "questions": {
        "probed": {
          "type": "choice",
          "instructions": "读 devine-app-integration-01-function /version（gate app）。",
          "criteria": {
            "A": "已读",
            "B": "不可访问"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "probe_integration_02"
      },
      "action": {
        "kind": "call",
        "capability": "integration_01_version",
        "project": {
          "integration_01_app_version": "/app_version",
          "integration_01_status": "/status"
        }
      }
    },
    {
      "name": "probe_integration_02",
      "primary_q": "probed",
      "questions": {
        "probed": {
          "type": "choice",
          "instructions": "读 devine-app-integration-02-function /version（post-promote app）。",
          "criteria": {
            "A": "已读",
            "B": "不可访问"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "snapshot_verdict"
      },
      "action": {
        "kind": "call",
        "capability": "integration_02_version",
        "project": {
          "integration_02_app_version": "/app_version",
          "integration_02_status": "/status"
        }
      }
    },
    {
      "name": "snapshot_verdict",
      "primary_q": "snapshot_verdict",
      "questions": {
        "snapshot_verdict": {
          "type": "choice",
          "instructions": "汇总四个 app 的 /version 快照，判断是否全部可达（HTTP 200 且 app_version 非空）。",
          "criteria": {
            "all_ok": "四个 app 全部 200 且 app_version 非空",
            "degraded": "至少一个不可达或 app_version 为空"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "state": {
        "keep": [
          "test_004_app_version",
          "test_001_app_version",
          "integration_01_app_version",
          "integration_02_app_version"
        ]
      },
      "action": {
        "kind": "threshold",
        "question": "snapshot_verdict",
        "rules": [
          {
            "when": {
              "answer": "degraded"
            },
            "label": "DEGRADED"
          },
          {
            "when": {
              "always": true
            },
            "label": "ALL_OK"
          }
        ]
      }
    }
  ]
}
