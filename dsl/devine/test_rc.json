{
  "name": "devine_test_rc",
  "dsl_version": 2,
  "description": "workflow test-rc 的声明式镜像：触发 dev-test app（devine-test-004-function）的 main pipeline（FAAS CI 自动拉取最新 prod artifactory 二进制，无需传版本变量），随后读取该 app 的 /version，要求 app_version == rc。对应 WorkflowTestRC / triggerAndPollApp（cmd/devine-utils-ci/internal/workflow_apps.go + workflow_gate.go）。触发与等待委托冻结的 devine-utils-ci；真实 CLI 会按 5s 间隔轮询 /version 至超时（默认 600s），本 spec 只做一次快照判定（DSL 无循环计数）。",
  "start": "trigger_test_004",
  "max_iterations": 6,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "policy": {
    "allow_exec": true,
    "allow_paths": [
      "${env.DEVINE_BINARY_REPO}"
    ],
    "allow_hosts": [
      "devine-test-004-function.fws.faas.qa.nt.ctripcorp.com"
    ],
    "max_timeout_ms": 600000,
    "max_output": 65536,
    "retries": 0
  },
  "capabilities": {
    "trigger_test_004": {
      "kind": "exec",
      "argv": [
        "devine-utils-ci",
        "pipeline-run",
        "faas/devine-test-004-function",
        "--ref",
        "main",
        "--output",
        "text",
        "--wait",
        "--wait-timeout",
        "600"
      ],
      "cwd": "${env.DEVINE_BINARY_REPO}",
      "timeout_ms": 600000,
      "max_output": 65536
    },
    "test_004_version": {
      "kind": "http",
      "method": "GET",
      "url": "http://devine-test-004-function.fws.faas.qa.nt.ctripcorp.com/version",
      "timeout_ms": 10000,
      "expect_json": true
    }
  },
  "nodes": [
    {
      "name": "trigger_test_004",
      "primary_q": "triggered",
      "questions": {
        "triggered": {
          "type": "choice",
          "instructions": "触发 devine-test-004-function（dev-test 默认 app）的 main 分支 pipeline 并等待其结束（CI 自动拉取最新 prod artifactory 二进制）。",
          "criteria": {
            "A": "pipeline 已触发并结束",
            "B": "触发或等待失败"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "probe_test_004_version"
      },
      "state": {
        "keep": [
          "rc"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "trigger_test_004",
        "project": {
          "trigger_exit_code": "/exit_code",
          "trigger_stdout": "/stdout"
        }
      }
    },
    {
      "name": "probe_test_004_version",
      "primary_q": "probed",
      "questions": {
        "probed": {
          "type": "choice",
          "instructions": "读取 devine-test-004-function /version 的 app_version（rc 是否真正上线的权威信号）。",
          "criteria": {
            "A": "已读取",
            "B": "不可访问"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "test_rc_verdict"
      },
      "state": {
        "keep": [
          "rc",
          "trigger_exit_code"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "test_004_version",
        "project": {
          "test_004_app_version": "/app_version",
          "test_004_http_status": "/status"
        }
      }
    },
    {
      "name": "test_rc_verdict",
      "primary_q": "test_rc_verdict",
      "questions": {
        "test_rc_verdict": {
          "type": "choice",
          "instructions": "判定 test-rc：trigger_exit_code 必须为 0（pipeline 成功），test_004_http_status 必须为 200，且 test_004_app_version 必须与 state.rc 完全相等。注意：真实 CLI 会按 5s 间隔轮询 /version（默认 600s）；本 spec 只做一次快照判定。",
          "criteria": {
            "pass": "pipeline 成功、HTTP 200 且 app_version == state.rc",
            "fail": "触发失败、非 200、或 app_version != state.rc"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "state": {
        "keep": [
          "rc",
          "test_004_app_version",
          "test_004_http_status",
          "trigger_exit_code"
        ]
      },
      "action": {
        "kind": "threshold",
        "question": "test_rc_verdict",
        "rules": [
          {
            "when": {
              "answer": "fail"
            },
            "label": "FAIL"
          },
          {
            "when": {
              "always": true
            },
            "label": "PASS"
          }
        ]
      }
    }
  ]
}
