{
  "name": "devine_post_promote_check",
  "dsl_version": 2,
  "description": "promote 之后的强制检查（规则 2）：正式版本发布完成后，必须立刻用 integration-02 测试，并轮询其 /version 直到 app_version == 刚发布的 stable。对应 runIntegration02AfterPromote（cmd/devine-utils-ci/internal/workflow_gate.go）。规则原文：正式版本发布完成，必须用 integration-02 立刻测试。",
  "start": "trigger_integration_02",
  "max_iterations": 6,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "policy": {
    "allow_exec": true,
    "allow_paths": [
      "${env.DEVINE_BINARY_REPO}"
    ],
    "allow_hosts": [
      "devine-app-integration-02-function.fws.faas.qa.nt.ctripcorp.com"
    ],
    "max_timeout_ms": 600000,
    "max_output": 65536,
    "retries": 0
  },
  "capabilities": {
    "trigger_integration_02": {
      "kind": "exec",
      "argv": [
        "devine-utils-ci",
        "pipeline-run",
        "faas/devine-app-integration-02-function",
        "--ref",
        "main",
        "--output",
        "text",
        "--wait",
        "--wait-timeout",
        "600"
      ],
      "cwd": "${env.DEVINE_BINARY_REPO}",
      "timeout_ms": 600000,
      "max_output": 65536
    },
    "integration_02_version": {
      "kind": "http",
      "method": "GET",
      "url": "http://devine-app-integration-02-function.fws.faas.qa.nt.ctripcorp.com/version",
      "timeout_ms": 10000,
      "expect_json": true
    }
  },
  "nodes": [
    {
      "name": "trigger_integration_02",
      "primary_q": "triggered",
      "questions": {
        "triggered": {
          "type": "choice",
          "instructions": "触发 integration-02 的 main 分支 pipeline 并等待其结束（CI 自动拉取最新 prod artifactory 二进制）。",
          "criteria": {
            "A": "pipeline 已触发",
            "B": "触发失败"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "probe_integration_02"
      },
      "state": {
        "keep": [
          "stable"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "trigger_integration_02",
        "project": {
          "trigger_exit_code": "/exit_code",
          "trigger_stdout": "/stdout"
        }
      }
    },
    {
      "name": "probe_integration_02",
      "primary_q": "probed",
      "questions": {
        "probed": {
          "type": "choice",
          "instructions": "读取 integration-02 /version 的 app_version（真实滚动状态的权威信号）。",
          "criteria": {
            "A": "已读取",
            "B": "不可访问"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "post_promote_verdict"
      },
      "state": {
        "keep": [
          "stable",
          "trigger_exit_code"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "integration_02_version",
        "project": {
          "integration_02_app_version": "/app_version",
          "integration_02_http_status": "/status"
        }
      }
    },
    {
      "name": "post_promote_verdict",
      "primary_q": "post_promote_verdict",
      "questions": {
        "post_promote_verdict": {
          "type": "choice",
          "instructions": "规则 2：正式版本发布完成，必须用 integration-02 立刻测试。判定依据：trigger_exit_code 必须为 0（pipeline 成功），integration_02_http_status 必须为 200，且 integration_02_app_version 必须与 state.stable 完全相等。",
          "criteria": {
            "pass": "pipeline 成功、HTTP 200 且 app_version == state.stable",
            "fail": "触发失败、非 200、或 app_version != state.stable"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "state": {
        "keep": [
          "stable",
          "integration_02_app_version",
          "integration_02_http_status",
          "trigger_exit_code"
        ]
      },
      "action": {
        "kind": "threshold",
        "question": "post_promote_verdict",
        "rules": [
          {
            "when": {
              "answer": "fail"
            },
            "label": "FAIL"
          },
          {
            "when": {
              "always": true
            },
            "label": "PASS"
          }
        ]
      }
    }
  ]
}
