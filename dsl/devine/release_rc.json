{
  "name": "devine_release_rc",
  "dsl_version": 2,
  "description": "workflow release-rc：在 main 上 bump 一个 rc（x.y.z-rc.N）、push main + tag，然后校验 UAT / PROD artifactory 上出现该版本的二进制（Upload UAT → Upload PROD 链）。变更动作委托给冻结的 devine-utils-ci CLI（exec），校验部分由本 spec 声明式表达。对应 WorkflowReleaseRC / pollArtifactory（cmd/devine-utils-ci/internal/workflow_release.go, workflow_util.go）。",
  "start": "bump_rc",
  "max_iterations": 6,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "policy": {
    "allow_exec": true,
    "allow_paths": [
      "${env.DEVINE_BINARY_REPO}"
    ],
    "allow_hosts": [
      "artifactory.release.ctripcorp.com"
    ],
    "max_timeout_ms": 120000,
    "max_output": 65536,
    "retries": 0
  },
  "capabilities": {
    "bump_rc": {
      "kind": "exec",
      "argv": [
        "devine-utils-ci",
        "workflow",
        "release-rc",
        "--verbose"
      ],
      "cwd": "${env.DEVINE_BINARY_REPO}",
      "timeout_ms": 120000,
      "max_output": 65536
    },
    "uat_artifact": {
      "kind": "http",
      "method": "GET",
      "url": "http://artifactory.release.ctripcorp.com/artifactory/trip-generic-binary-uat-shanghai/devine-golang-mcp-app/uat/linux-amd64/${state.next_version}/devine-golang-mcp-app",
      "timeout_ms": 15000,
      "expect_json": false
    },
    "prod_artifact": {
      "kind": "http",
      "method": "GET",
      "url": "http://artifactory.release.ctripcorp.com/artifactory/trip-generic-binary-prod-shanghai/devine-golang-mcp-app/prod/linux-amd64/${state.next_version}/devine-golang-mcp-app",
      "timeout_ms": 15000,
      "expect_json": false
    }
  },
  "nodes": [
    {
      "name": "bump_rc",
      "primary_q": "bumped",
      "questions": {
        "bumped": {
          "type": "choice",
          "instructions": "执行 rc bump：读 VERSION → 计算下一个 x.y.z-rc.N → commit → push main + 推送 tag（委托 devine-utils-ci workflow release-rc）。",
          "criteria": {
            "A": "bump 已执行",
            "B": "bump 失败"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "probe_uat_artifact"
      },
      "state": {
        "keep": [
          "next_version"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "bump_rc",
        "project": {
          "bump_exit_code": "/exit_code",
          "bump_stdout": "/stdout"
        }
      }
    },
    {
      "name": "probe_uat_artifact",
      "primary_q": "probed",
      "questions": {
        "probed": {
          "type": "choice",
          "instructions": "匿名 GET UAT artifactory 上 <version>/devine-golang-mcp-app 是否 200 且大小 >= 1,000,000 B。",
          "criteria": {
            "A": "已探测",
            "B": "不可访问"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "probe_prod_artifact"
      },
      "state": {
        "keep": [
          "next_version",
          "bump_exit_code"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "uat_artifact",
        "project": {
          "uat_status": "/status"
        }
      }
    },
    {
      "name": "probe_prod_artifact",
      "primary_q": "probed",
      "questions": {
        "probed": {
          "type": "choice",
          "instructions": "匿名 GET PROD artifactory 上 <version>/devine-golang-mcp-app 是否 200（Upload PROD 通常滞后于 UAT）。",
          "criteria": {
            "A": "已探测",
            "B": "不可访问"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "release_verdict"
      },
      "state": {
        "keep": [
          "next_version",
          "uat_status"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "prod_artifact",
        "project": {
          "prod_status": "/status"
        }
      }
    },
    {
      "name": "release_verdict",
      "primary_q": "release_verdict",
      "questions": {
        "release_verdict": {
          "type": "choice",
          "instructions": "判定 rc 发布：bump_exit_code == 0，且 uat_status == 200，且 prod_status == 200。UAT 成功但 PROD 滞后时应报 FAIL 并给出 tag pipeline 链接（<GitLabBase>/-/pipelines?scope=tags）。注意：CLI 会按 20s 间隔轮询最多 1800s；本 spec 只做一次快照判定。",
          "criteria": {
            "ok": "bump 成功且 UAT、PROD 均为 200",
            "fail": "bump 失败，或 UAT/PROD 任一未 200"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "state": {
        "keep": [
          "next_version",
          "bump_exit_code",
          "uat_status",
          "prod_status"
        ]
      },
      "action": {
        "kind": "threshold",
        "question": "release_verdict",
        "rules": [
          {
            "when": {
              "answer": "fail"
            },
            "label": "FAIL"
          },
          {
            "when": {
              "always": true
            },
            "label": "OK"
          }
        ]
      }
    }
  ]
}
