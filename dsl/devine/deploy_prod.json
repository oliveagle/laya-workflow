{
  "name": "devine_deploy_prod",
  "dsl_version": 2,
  "description": "workflow deploy-prod：把 FAT release group 的最新 SUCCESS 镜像发布到某个 PROD release group，并校验 PROD /spec 仍暴露约定的 MCP tool（spec-drift 防护）。对应 WorkflowDeployProd（cmd/devine-utils-ci/internal/workflow_deploy_prod.go）。Captain 写接口需要 UI 会话 x-user-token（OAuth access_token 只读 → 401）。本 spec 参数化：state 传 app_name / fat_group_id / prod_group_id / prod_url / spec_tool。",
  "start": "resolve_fat_image",
  "max_iterations": 8,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "policy": {
    "allow_exec": false,
    "allow_hosts": [
      "captain.release.ctripcorp.com",
      "devine-test-004-function.faas.ctripcorp.com",
      "devine-test-001-function.faas.ctripcorp.com",
      "devine-app-integration-01-function.faas.ctripcorp.com",
      "devine-app-integration-02-function.faas.ctripcorp.com"
    ],
    "max_timeout_ms": 30000,
    "max_output": 262144,
    "retries": 1
  },
  "capabilities": {
    "captain_headers": {
      "kind": "passthrough"
    },
    "fat_releases": {
      "kind": "http",
      "method": "GET",
      "url": "https://captain.release.ctripcorp.com/faas/v1/releases?group_id=${state.fat_group_id}&per_page=10",
      "headers": {
        "X-USER-TOKEN": "${secret.CAPTAIN_USER_TOKEN}",
        "Accept": "application/json"
      },
      "timeout_ms": 15000,
      "expect_json": true
    },
    "auto_deploy": {
      "kind": "http",
      "method": "POST",
      "url": "https://captain.release.ctripcorp.com/faas/v1/releases/auto_deploy",
      "headers": {
        "X-USER-TOKEN": "${secret.CAPTAIN_USER_TOKEN}",
        "Content-Type": "application/json"
      },
      "body": {
        "id": "${state.prod_group_id}",
        "resource": "RESOURCE_GROUP",
        "image_url": "${state.fat_latest_image}",
        "batches": [
          {
            "percent": 100,
            "delay": 0
          }
        ],
        "username": "rhtang"
      },
      "timeout_ms": 20000,
      "expect_json": true
    },
    "rollout": {
      "kind": "http",
      "method": "POST",
      "url": "https://captain.release.ctripcorp.com/faas/v1/releases/${with.deploy.body.id}/rollout",
      "headers": {
        "X-USER-TOKEN": "${secret.CAPTAIN_USER_TOKEN}",
        "Content-Type": "application/json"
      },
      "body": {},
      "timeout_ms": 20000,
      "expect_json": true
    },
    "prod_releases": {
      "kind": "http",
      "method": "GET",
      "url": "https://captain.release.ctripcorp.com/faas/v1/releases?group_id=${state.prod_group_id}&per_page=10",
      "headers": {
        "X-USER-TOKEN": "${secret.CAPTAIN_USER_TOKEN}",
        "Accept": "application/json"
      },
      "timeout_ms": 15000,
      "expect_json": true
    },
    "prod_spec": {
      "kind": "http",
      "method": "GET",
      "url": "${state.prod_url}/spec",
      "timeout_ms": 15000,
      "expect_json": true
    }
  },
  "nodes": [
    {
      "name": "resolve_fat_image",
      "primary_q": "resolved",
      "questions": {
        "resolved": {
          "type": "choice",
          "instructions": "从 FAT release group 里取出最新一条 SUCCESS release 的 Image URL（含时间戳后缀，auto_deploy 需要精确 image）。",
          "criteria": {
            "A": "已取得 image",
            "B": "FAT group 无可用的 SUCCESS release"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "deploy_and_rollout"
      },
      "state": {
        "keep": [
          "app_name",
          "fat_group_id",
          "prod_group_id",
          "prod_url",
          "spec_tool"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "fat_releases",
        "project": {
          "fat_releases": "/result"
        }
      }
    },
    {
      "name": "deploy_and_rollout",
      "primary_q": "deployed",
      "questions": {
        "deployed": {
          "type": "choice",
          "instructions": "在 PROD group 上 auto_deploy 刚选定的镜像（release 初始为 PENDING），随即 rollout 推进发布。",
          "criteria": {
            "A": "已创建并 rollout",
            "B": "auto_deploy/rollout 失败"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "check_prod_release"
      },
      "state": {
        "keep": [
          "fat_latest_image",
          "prod_group_id"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "auto_deploy",
        "chain": [
          {
            "capability": "auto_deploy",
            "as": "deploy"
          },
          {
            "capability": "rollout",
            "as": "rollout"
          }
        ],
        "with": {
          "app_name": "${state.app_name}"
        },
        "project": {
          "deploy_release_id": "/deploy/body/id",
          "deploy_status": "/deploy/status",
          "rollout_status": "/rollout/status"
        }
      }
    },
    {
      "name": "check_prod_release",
      "primary_q": "checked",
      "questions": {
        "checked": {
          "type": "choice",
          "instructions": "读取 PROD group 最近的 release 列表，找出正在发布 state.fat_latest_image 的那条 release 及其 status。",
          "criteria": {
            "A": "已取得 release 状态",
            "B": "读取失败"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "verify_prod_spec"
      },
      "state": {
        "keep": [
          "deploy_release_id",
          "fat_latest_image"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "prod_releases",
        "project": {
          "prod_releases": "/result"
        }
      }
    },
    {
      "name": "verify_prod_spec",
      "primary_q": "spec_checked",
      "questions": {
        "spec_checked": {
          "type": "choice",
          "instructions": "读取 PROD /spec 的工具列表（spec-drift 防护：升级后 http_self_ping 等约定 tool 不能丢）。",
          "criteria": {
            "A": "已取得 /spec",
            "B": "不可访问"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "deploy_verdict"
      },
      "state": {
        "keep": [
          "prod_url",
          "spec_tool",
          "prod_releases"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "prod_spec",
        "project": {
          "prod_spec_tools": "/"
        }
      }
    },
    {
      "name": "deploy_verdict",
      "primary_q": "deploy_verdict",
      "questions": {
        "deploy_verdict": {
          "type": "choice",
          "instructions": "判定本次 PROD 部署：target image == state.fat_latest_image 的 release 必须达到 SUCCESS（REVERTED/REVOKED/FAILED/PENDING 都算未成功）；同时 PROD /spec 的工具列表里必须包含 state.spec_tool。注意：实际 CLI 会按 15s 间隔轮询至 SUCCESS，本 spec 只做一次快照判定。",
          "criteria": {
            "ok": "release SUCCESS 且 /spec 暴露了 spec_tool",
            "fail": "release 未 SUCCESS 或 /spec 缺少 spec_tool"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "state": {
        "keep": [
          "app_name",
          "prod_group_id",
          "prod_url",
          "spec_tool"
        ]
      },
      "action": {
        "kind": "threshold",
        "question": "deploy_verdict",
        "rules": [
          {
            "when": {
              "answer": "fail"
            },
            "label": "FAIL"
          },
          {
            "when": {
              "always": true
            },
            "label": "OK"
          }
        ]
      }
    }
  ]
}
