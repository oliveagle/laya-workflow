{
  "name": "db_server_analytics",
  "dsl_version": 2,
  "description": "The *server* mode of `kind: \"db\"`: the identical HTAP ops, but each call is POSTed to a long-lived `laya-workflow db serve` daemon that owns the SQLite(+DuckDB) pair, so many workflows share one writer. Start it first: `laya-workflow db serve --sqlite $LAYA_WORK_DIR/shop.sqlite --port 18767 --daemon`. Server mode spawns no process, so `policy.allow_exec` is not needed here — only the daemon needs it. See docs/db.md.",
  "start": "reset",
  "max_iterations": 10,
  "policy": {
    "max_output": 262144
  },
  "capabilities": {
    "store_ro": { "kind": "db", "mode": "server", "endpoint": "http://127.0.0.1:18767" },
    "store_rw": { "kind": "db", "mode": "server", "endpoint": "http://127.0.0.1:18767", "readonly": false }
  },
  "nodes": [
    {
      "name": "reset",
      "primary_q": "go",
      "questions": { "go": { "type": "choice", "instructions": "Reset the rows in SQLite (via the daemon)?", "criteria": { "A": "yes" } } },
      "edge": { "condition": {}, "default": "report" },
      "action": {
        "kind": "call",
        "capability": "store_rw",
        "with": {
          "op": "exec",
          "statements": [
            "CREATE TABLE IF NOT EXISTS sales (id INTEGER PRIMARY KEY, region TEXT NOT NULL, amount REAL NOT NULL)",
            "DELETE FROM sales",
            "INSERT INTO sales (region, amount) VALUES ('east', 10.5), ('west', 20.0), ('east', 5.25), ('west', 1.5)"
          ]
        },
        "project": { "ok": "/ok", "http_status": "/http_status" }
      }
    },
    {
      "name": "report",
      "primary_q": "go",
      "questions": { "go": { "type": "choice", "instructions": "Aggregate with DuckDB (through the daemon)?", "criteria": { "A": "yes" } } },
      "edge": { "condition": {}, "default": "persist" },
      "action": {
        "kind": "call",
        "capability": "store_ro",
        "with": {
          "op": "analytics",
          "format": "json",
          "sql": "SELECT region, SUM(amount) AS total, COUNT(*) AS n FROM sales GROUP BY region ORDER BY region"
        },
        "project": { "rows": "/rows", "engine": "/engine", "mode": "/mode" }
      }
    },
    {
      "name": "persist",
      "primary_q": "go",
      "questions": { "go": { "type": "choice", "instructions": "Write the aggregate back to SQLite?", "criteria": { "A": "yes" } } },
      "edge": { "condition": {}, "default": "verify" },
      "action": {
        "kind": "call",
        "capability": "store_rw",
        "with": {
          "op": "sync",
          "create": true,
          "into": "region_totals",
          "sql": "SELECT region, SUM(amount) AS total, COUNT(*) AS n FROM sales GROUP BY region"
        },
        "project": { "ok": "/ok", "http_status": "/http_status" }
      }
    },
    {
      "name": "verify",
      "primary_q": "go",
      "questions": { "go": { "type": "choice", "instructions": "Read the materialised table back?", "criteria": { "A": "yes" } } },
      "edge": { "condition": {}, "default": "inspect" },
      "action": {
        "kind": "call",
        "capability": "store_ro",
        "with": { "op": "query", "sql": "SELECT region, total, n FROM region_totals ORDER BY region" },
        "project": { "rows": "/rows" }
      }
    },
    {
      "name": "inspect",
      "primary_q": "go",
      "questions": { "go": { "type": "choice", "instructions": "List what each engine sees?", "criteria": { "A": "yes" } } },
      "edge": { "condition": {}, "default": "STOP" },
      "action": {
        "kind": "call",
        "capability": "store_ro",
        "with": { "op": "tables" },
        "project": { "engines": "/rows" }
      }
    }
  ]
}
