{
  "name": "credentialed_integrations",
  "dsl_version": 2,
  "description": "Credentials never live in a spec: every secret is referenced as ${secret.NAME} and resolved at call time from the environment or a .env / secrets file. Values are redacted from all output.",
  "start": "route",
  "max_iterations": 15,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "policy": {
    "allow_exec": false,
    "allow_hosts": [
      "127.0.0.1",
      "localhost"
    ],
    "max_timeout_ms": 8000,
    "max_output": 32768,
    "retries": 1,
    "allow_paths": [
      "${env.LAYA_STORE_DIR}"
    ]
  },
  "capabilities": {
    "signed_notify": {
      "kind": "webhook",
      "url": "http://127.0.0.1:8791/webhook",
      "sign_header": "x-signature",
      "sign_secret": "${secret.LAYA_WEBHOOK_SECRET}",
      "timeout_ms": 4000
    },
    "vendor_api": {
      "kind": "http",
      "method": "POST",
      "url": "http://127.0.0.1:8791/score",
      "headers": {
        "content-type": "application/json",
        "authorization": "Bearer ${secret.LAYA_VENDOR_TOKEN}"
      },
      "body": {
        "text": "${state.text}"
      },
      "timeout_ms": 4000
    },
    "mailer": {
      "kind": "smtp",
      "host": "127.0.0.1",
      "port": 2526,
      "from": "workflow@example.com",
      "username": "${secret.LAYA_SMTP_USER}",
      "password": "${secret.LAYA_SMTP_PASS}",
      "timeout_ms": 5000
    },
    "cached_token": {
      "kind": "cache",
      "op": "set",
      "path": "${env.LAYA_STORE_DIR}/tokens.json",
      "ttl_secs": 900
    }
  },
  "nodes": [
    {
      "name": "route",
      "primary_q": "channel",
      "questions": {
        "channel": {
          "type": "choice",
          "instructions": "Which credentialed integration should this request use?",
          "criteria": {
            "vendor": "a third-party API that needs an API token",
            "notify": "an outbound webhook that must be signed with a shared secret",
            "email": "an SMTP send that needs a username and password"
          }
        }
      },
      "edge": {
        "condition": {
          "vendor": "call_vendor",
          "notify": "send_hook",
          "email": "send_mail"
        },
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "max_retries": 1,
      "action": {
        "kind": "copy_keys",
        "keys": [
          "channel"
        ]
      }
    },
    {
      "name": "call_vendor",
      "primary_q": "ok",
      "questions": {
        "ok": {
          "type": "choice",
          "instructions": "proceed?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "action": {
        "kind": "call",
        "capability": "vendor_api",
        "with": {
          "text": "${state.text}"
        },
        "project": {
          "vendor_status": "/status",
          "vendor_label": "/body/label"
        }
      }
    },
    {
      "name": "send_hook",
      "primary_q": "ok",
      "questions": {
        "ok": {
          "type": "choice",
          "instructions": "proceed?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "action": {
        "kind": "call",
        "capability": "signed_notify",
        "with": {
          "event": "routed",
          "payload": {
            "text": "${state.text}"
          }
        },
        "project": {
          "hook_status": "/status",
          "hook_signed": "/signed"
        }
      }
    },
    {
      "name": "send_mail",
      "primary_q": "ok",
      "questions": {
        "ok": {
          "type": "choice",
          "instructions": "proceed?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "action": {
        "kind": "call",
        "capability": "mailer",
        "chain": [
          {
            "capability": "cached_token",
            "as": "tok",
            "with": {
              "key": "mailer",
              "value": "issued"
            }
          }
        ],
        "with": {
          "to": [
            "ops@example.com"
          ],
          "subject": "workflow",
          "body": "${state.text}"
        },
        "project": {
          "mail_authed": "/authed",
          "token_ttl_set": "/tok/ttl_secs"
        }
      }
    }
  ]
}
