{
  "name": "support_ticket_router_hybrid",
  "_bdd": {
    "feature": "support_ticket_router_hybrid",
    "feature_path": "bdd/workflows/routing/support_ticket_router_hybrid.feature",
    "mode": "decision"
  },
  "description": "Port of support_ticket_router_hybrid: converted from dsl/routing/support_ticket_router_hybrid.json (BDD round-trip).",
  "start": "classify",
  "max_iterations": 20,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "nodes": [
    {
      "name": "classify",
      "primary_q": "category",
      "questions": {
        "category": {
          "type": "choice",
          "instructions": "Which team should handle this ticket?",
          "criteria": {
            "billing": "invoices, payments, refunds",
            "technical": "bugs, outages, system errors",
            "sales": "pricing, new contracts",
            "other": "everything else"
          },
          "heuristic": {
            "match_rules_all": {
              "technical": [
                [
                  [
                    "outage",
                    "500",
                    "hotfix",
                    "incident",
                    "prod",
                    "unavailable"
                  ]
                ]
              ],
              "billing": [
                [
                  [
                    "refund",
                    "invoice",
                    "billed",
                    "payment",
                    "duplicate charge"
                  ]
                ]
              ],
              "sales": [
                [
                  [
                    "pricing",
                    "demo",
                    "purchase",
                    "quote",
                    "trial"
                  ]
                ]
              ],
              "shipping": [
                [
                  [
                    "package",
                    "parcel",
                    "delivery",
                    "deliver",
                    "courier",
                    "shipment",
                    "shipping",
                    "arrived",
                    "arrive",
                    "customs",
                    "tracking"
                  ]
                ]
              ],
              "account": [
                [
                  [
                    "login",
                    "password",
                    "access",
                    "profile",
                    "reset"
                  ]
                ]
              ],
              "hr": [
                [
                  [
                    "leave",
                    "payroll",
                    "hiring",
                    "vacation",
                    "pto"
                  ]
                ]
              ]
            },
            "p_hit": 0.9,
            "p_miss": 0.02,
            "fallback": "other",
            "p_fallback": 0.9
          }
        }
      },
      "edge": {
        "condition": {
          "technical": "severity_probe",
          "billing": "severity_probe"
        },
        "default": "needle_fallback"
      },
      "min_confidence": 0.0,
      "max_retries": 1,
      "action": {
        "kind": "copy_keys",
        "keys": [
          "category"
        ]
      }
    },
    {
      "name": "needle_fallback",
      "primary_q": "cat",
      "questions": {
        "cat": {
          "type": "choice",
          "instructions": "Semantic category from the on-device model.",
          "criteria": {
            "billing": "money, refund, invoice, payment",
            "technical": "crash, error, broken, bug, outage",
            "shipping": "delivery, package, arrived, order status",
            "other": "everything else"
          }
        }
      },
      "edge": {
        "condition": {
          "technical": "severity_probe",
          "billing": "severity_probe",
          "shipping": "severity_probe"
        },
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "max_retries": 1,
      "action": {
        "kind": "call",
        "capability": "cls",
        "with": {
          "system": "date: 2026-10-07; locale: en-US; this is a customer support inbox.",
          "prompt": "${state.text}",
          "tools": [
            {
              "type": "function",
              "name": "refund_order",
              "description": "Give the customer their money back for a purchase.",
              "triggers": [
                "\\b(refund|return|charge.?back)\\b",
                "\\bmoney\\s*back\\b",
                "\\btake\\s*(it|them)\\s*back\\b",
                "\\b(cancel|reverse)\\s+(this\\s+)?(purchase|order|charge)\\b",
                "\\bcredit\\s+me\\b"
              ],
              "parameters": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string"
                  }
                },
                "required": []
              }
            },
            {
              "type": "function",
              "name": "fix_technical",
              "description": "Help with a broken device, app, or connection.",
              "triggers": [
                "\\b(wifi|internet|bluetooth|app|software)\\b",
                "\\b(crash|freeze|stutter|drop|pair|sign\\s*in)\\b",
                "\\b(500|error|broken|not\\s*working|won.t)\\b"
              ],
              "parameters": {
                "type": "object",
                "properties": {
                  "issue": {
                    "type": "string"
                  }
                },
                "required": []
              }
            },
            {
              "type": "function",
              "name": "track_package",
              "description": "Find where a delivery is or change its address.",
              "triggers": [
                "\\b(package|parcel|order|delivery|deliver|courier|shipment|track|arriv|customs)\\b"
              ],
              "parameters": {
                "type": "object",
                "properties": {
                  "order_id": {
                    "type": "string"
                  }
                },
                "required": []
              }
            }
          ]
        },
        "project": {
          "category": "/function_calls/0/name"
        }
      }
    },
    {
      "name": "severity_probe",
      "primary_q": "severity",
      "questions": {
        "severity": {
          "type": "score",
          "instructions": "How severe is the impact?",
          "criteria": [
            "minor",
            "degraded",
            "outage"
          ],
          "heuristic": {
            "score_rules": {
              "2": [
                "vermin",
                "watch your back",
                "get rich",
                "123-45-6789"
              ]
            },
            "score_miss": 0.5
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "action": {
        "kind": "threshold",
        "question": "severity",
        "rules": [
          {
            "when": {
              "question": "severity",
              "value_gte": 1.5
            },
            "label": "PAGE_ONCALL"
          },
          {
            "when": {
              "question": "severity",
              "value_gte": 0.5
            },
            "label": "QUEUE_TODAY"
          },
          {
            "when": {
              "always": true
            },
            "label": "BACKLOG"
          }
        ]
      }
    }
  ],
  "policy": {
    "allow_exec": false,
    "allow_hosts": [],
    "allow_paths": [
      "${env.HOME}"
    ],
    "max_timeout_ms": 20000,
    "max_output": 65536
  },
  "capabilities": {
    "cls": {
      "kind": "needle",
      "op": "complete",
      "cact": "${env.NEEDLE3_CACT}"
    }
  }
}
