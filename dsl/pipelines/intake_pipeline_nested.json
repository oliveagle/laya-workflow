{
  "name": "intake_pipeline_nested",
  "description": "Nested/referenced workflow: the intake node embeds the standalone 'support_ticket_router' workflow as a sub-graph, then adds a local audit step. Proves workflows can compose by reference with no Rust changes.",
  "start": "prefilter",
  "max_iterations": 30,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "nodes": [
    {
      "name": "prefilter",
      "primary_q": "is_noise",
      "questions": {
        "is_noise": {
          "type": "choice",
          "instructions": "Is this message noise that should be dropped before routing?",
          "criteria": {
            "A": "no, it is a real request that needs routing",
            "B": "yes, it is automated noise or a duplicate"
          },
          "heuristic": {
            "field": "text",
            "match_rules": {
              "B": [
                "digest",
                "newsletter",
                "archived",
                "automated",
                "no action needed",
                "unsubscribe"
              ]
            },
            "p_hit": 0.9,
            "fallback": "A"
          }
        }
      },
      "edge": {
        "condition": {
          "A": "intake"
        },
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "max_retries": 1
    },
    {
      "name": "intake",
      "workflow": "support_ticket_router",
      "edge": {
        "condition": {},
        "default": "audit"
      }
    },
    {
      "name": "audit",
      "primary_q": "needs_human",
      "questions": {
        "needs_human": {
          "type": "choice",
          "instructions": "Given the routing outcome, does a human need to double-check it?",
          "criteria": {
            "A": "no, the automated routing is trustworthy",
            "B": "yes, a human should verify before acting"
          },
          "heuristic": {
            "field": "text",
            "match_any": [
              "500",
              "outage",
              "hotfix",
              "incident",
              "prod",
              "blocked",
              "revenue"
            ],
            "p_hit": 0.9,
            "p_miss": 0.1
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "action": {
        "kind": "threshold",
        "question": "needs_human",
        "rules": [
          {
            "when": {
              "option": "B",
              "gte": 0.5
            },
            "label": "AUDIT_REQUIRED"
          },
          {
            "when": {
              "always": true
            },
            "label": "AUDIT_SKIPPED"
          }
        ]
      }
    }
  ]
}
