{
  "name": "refund_policy",
  "dsl_version": 2,
  "description": "v2: adds a fraud signal — high fraud prob forces manual review regardless of amount.",
  "start": "band",
  "max_iterations": 5,
  "nodes": [
    {
      "name": "band",
      "primary_q": "amount_band",
      "questions": {
        "amount_band": {
          "type": "score",
          "instructions": "Rough size of the refund request?",
          "criteria": [
            "tokens / cents",
            "single invoice",
            "large or recurring"
          ],
          "heuristic": {
            "field": "text",
            "match_any": [
              "large"
            ],
            "match_mid_any": [
              "recurring"
            ],
            "score_hit": 2.0,
            "score_mid": 1.5,
            "score_miss": 0.5
          }
        },
        "is_suspicious": {
          "type": "choice",
          "instructions": "Does the request look fraudulent or scripted?",
          "criteria": {
            "A": "no, it looks like a genuine customer request",
            "B": "yes, it looks fraudulent, scripted, or otherwise suspicious"
          },
          "heuristic": {
            "match_any": [
              "fraud",
              "scripted",
              "bulk",
              "urgent"
            ],
            "p_hit": 0.95,
            "p_miss": 0.05
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "action": {
        "kind": "threshold",
        "question": "amount_band",
        "rules": [
          {
            "when": {
              "question": "is_suspicious",
              "option": "B",
              "gte": 0.5
            },
            "label": "V2_MANUAL_REVIEW"
          },
          {
            "when": {
              "value_gte": 1.5
            },
            "label": "V2_ESCALATE"
          },
          {
            "when": {
              "always": true
            },
            "label": "V2_AUTO_APPROVE"
          }
        ]
      }
    }
  ]
}
