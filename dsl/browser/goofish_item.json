{
  "name": "goofish_items",
  "dsl_version": 2,
  "description": "闲鱼(goofish.com) 商品搜索 / 浏览 / 信息收集 / 价格监控，由 Rhai 插件 websites/goofish 驱动 (kind: \"plugin\"). 用 --query 传搜索词、商品链接或商品 id；插件推断模式：'iphone' 之类是搜索，'https://www.goofish.com/item?id=...' 是单件浏览，'价格监控'/'watch price' 是价格监控。可用 state.mode 显式指定 search|item|watch|watch_add。搜索结果每条都会写成 out_dir/items/<id>.json (默认 ~/tmp/goofish)；加 browse:N 会把前 N 条打开成完整详情(描述/属性/卖家/图片)。单件浏览加 markdown 会额外存 Markdown 与图片。注意 goofish 的 /search 忽略 ?page= 与 ?sort=，翻页由插件点击页面上的页码完成，所以 count 较大时用 pages 控制；price_min/price_max 是取回后在本地过滤(站点不认这两个查询参数)。价格监控读 out_dir/watch.json 里记录的历史，每次 watch 会重新抓取被监控商品并给出 changes(new/down/up/same/gone) 与 summary，drop_pct 可设百分比阈值过滤播报。默认 watch 一次最多检查 watch_limit(20) 件，用 watch_query 过滤标题。",
  "start": "collect",
  "max_iterations": 2,
  "policy": {
    "allow_exec": true,
    "allow_hosts": [],
    "allow_paths": [
      "${env.HOME}/.laya-workflow",
      "${env.HOME}/tmp/goofish"
    ],
    "max_timeout_ms": 600000,
    "max_output": 8388608,
    "retries": 0
  },
  "capabilities": {
    "browser": {
      "kind": "browser",
      "endpoint": "http://127.0.0.1:9222",
      "launch": true,
      "startup_timeout_ms": 20000,
      "timeout_ms": 90000,
      "max_text": 20000
    },
    "goofish": {
      "kind": "plugin",
      "plugin": "websites/goofish",
      "browser": "browser",
      "timeout_ms": 540000,
      "max_operations": 4000000
    }
  },
  "nodes": [
    {
      "name": "collect",
      "primary_q": "done",
      "questions": {
        "done": {
          "type": "choice",
          "instructions": "Collect the requested goofish items / price changes?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "action": {
        "kind": "call",
        "capability": "goofish",
        "with": {
          "query": "${state.query}",
          "mode": "${state.mode}",
          "item_url": "${state.item_url}",
          "count": "${state.count}",
          "pages": "${state.pages}",
          "browse": "${state.browse}",
          "out_dir": "${state.out_dir}",
          "markdown": "${state.markdown}",
          "track": "${state.track}",
          "save_listing": "${state.save_listing}",
          "price_min": "${state.price_min}",
          "price_max": "${state.price_max}",
          "watch_query": "${state.watch_query}",
          "watch_limit": "${state.watch_limit}",
          "drop_pct": "${state.drop_pct}",
          "history_max": "${state.history_max}",
          "page_budget_ms": "${state.page_budget_ms}",
          "keep_open": "${state.keep_open}",
          "selector": "${state.selector}"
        },
        "project": {
          "mode": "/mode",
          "source_url": "/source_url",
          "found_count": "/found_count",
          "failed_count": "/failed_count",
          "checked_count": "/checked_count",
          "gone_count": "/gone_count",
          "tracked_count": "/tracked_count",
          "watch_file": "/watch_file",
          "watch_saved": "/watch_saved",
          "pages_visited": "/pages_visited",
          "price_filtered_out": "/price_filtered_out",
          "summary": "/summary",
          "notes": "/notes",
          "changes": "/changes",
          "results": "/results",
          "failures": "/failures"
        }
      }
    }
  ]
}