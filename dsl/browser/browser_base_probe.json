{
  "name": "browser_base_probe",
  "dsl_version": 2,
  "description": "A hand-written multi-step spec - open -> wait_htmx -> assert -> done - that four documents point at as the canonical \"chrome_cdp owns the page across nodes\" shape. The assert node requires htmx_ok: true, so the wait it sits behind is actually checked: this used to run against the htmx-less index.html, spend the whole 15000ms wait_htmx budget, report htmx_loaded: false and still pass, because nothing looked at the result. scripts/bdd/run.py points it at bdd/fixtures/htmx.html and requires all four nodes.",
  "start": "open",
  "max_iterations": 5,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "policy": {
    "allow_exec": true,
    "allow_hosts": [
      "127.0.0.1",
      "localhost"
    ],
    "max_timeout_ms": 120000,
    "max_output": 262144,
    "retries": 0
  },
  "capabilities": {
    "chrome": {
      "kind": "chrome_cdp",
      "endpoint": "http://127.0.0.1:${state.cdp_port}",
      "launch": true,
      "startup_timeout_ms": 20000,
      "timeout_ms": 15000,
      "max_text": 6000,
      "max_owned_pages": 32,
      "owned_idle_ms": 300000,
      "profile_dir": "${state.cdp_profile}",
      "chrome_binary": "scripts/bdd/chrome-headless.sh"
    },
    "page_open": {
      "kind": "plugin",
      "plugin": "browser_base",
      "op": "open",
      "browser": "chrome",
      "timeout_ms": 60000
    },
    "page_htmx": {
      "kind": "plugin",
      "plugin": "browser_base",
      "op": "wait_htmx",
      "browser": "chrome",
      "timeout_ms": 60000
    },
    "page_assert": {
      "kind": "plugin",
      "plugin": "browser_base",
      "op": "assert",
      "browser": "chrome",
      "timeout_ms": 60000
    }
  },
  "nodes": [
    {
      "name": "open",
      "primary_q": "ok",
      "questions": {
        "ok": {
          "type": "choice",
          "instructions": "Open the target URL in a real Chrome page and wait until it is actually loaded (URL matches + readyState complete)?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "wait_htmx"
      },
      "state": {
        "keep": [
          "url"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "page_open",
        "with": {
          "url": "${state.url}"
        },
        "project": {
          "page_url": "/url",
          "page_title": "/title",
          "page_sample": "/sample"
        }
      }
    },
    {
      "name": "wait_htmx",
      "primary_q": "ok",
      "questions": {
        "ok": {
          "type": "choice",
          "instructions": "Wait up to 15s for window.htmx to become defined on the page, then report whether it loaded?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "assert"
      },
      "state": {
        "keep": [
          "url"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "page_htmx",
        "with": {
          "url": "${state.url}"
        },
        "project": {
          "htmx_loaded": "/htmx_loaded",
          "htmx_url": "/url",
          "htmx_title": "/title"
        }
      }
    },
    {
      "name": "assert",
      "primary_q": "ok",
      "questions": {
        "ok": {
          "type": "choice",
          "instructions": "Run the generic rendered-page assertion (non-empty title and body text) and require it to pass?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "done"
      },
      "state": {
        "keep": [
          "url"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "page_assert",
        "with": {
          "url": "${state.url}",
          "expression": "({ title_ok: (document.title || \"\").length > 0, text_ok: !!(document.body && document.body.innerText.length > 0), htmx_ok: typeof window.htmx === \"object\", url: location.href, sample: document.body ? document.body.innerText.slice(0,200) : \"\" })",
          "checks": {
            "title_ok": true,
            "text_ok": true,
            "htmx_ok": true
          }
        },
        "project": {
          "assert_url": "/url",
          "assert_sample": "/sample",
          "assert_pass": "/pass"
        }
      }
    },
    {
      "name": "done",
      "primary_q": "done",
      "questions": {
        "done": {
          "type": "choice",
          "instructions": "Is the browser_base probe complete after the page loaded, htmx was reported, and the render assertion passed?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "state": {
        "keep": [
          "url"
        ]
      }
    }
  ]
}
