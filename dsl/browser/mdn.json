{
  "name": "mdn_reader",
  "dsl_version": 2,
  "description": "Read MDN Web Docs, driven by the Rhai plugin `plugins/mdn` (kind: \"plugin\"). --query \"fetch api\" searches docs through MDN's public search API (title / summary / link); a doc path or URL (/en-US/docs/Web/API/Fetch_API) reads that page into Markdown under out_dir (default ~/tmp/mdn) via the Chrome tab. Optional state: mode (auto|search|page), lang/locale (default en-US), count/limit (1-30), out_dir.",
  "start": "read",
  "max_iterations": 2,
  "policy": {
    "allow_exec": true,
    "allow_hosts": [
      "127.0.0.1",
      "developer.mozilla.org"
    ],
    "allow_paths": [
      "${env.HOME}/.laya-workflow",
      "${env.HOME}/tmp/mdn"
    ],
    "max_timeout_ms": 60000,
    "max_output": 8388608,
    "retries": 0
  },
  "capabilities": {
    "chrome": {
      "kind": "chrome_cdp",
      "endpoint": "http://127.0.0.1:9222",
      "launch": true,
      "startup_timeout_ms": 20000,
      "timeout_ms": 30000,
      "max_text": 8000
    },
    "mdn": {
      "kind": "plugin",
      "plugin": "mdn",
      "browser": "chrome",
      "timeout_ms": 30000
    }
  },
  "nodes": [
    {
      "name": "read",
      "primary_q": "done",
      "questions": {
        "done": {
          "type": "choice",
          "instructions": "Read MDN as requested?",
          "criteria": { "A": "yes", "B": "no" }
        }
      },
      "edge": { "condition": {}, "default": "STOP" },
      "action": {
        "kind": "call",
        "capability": "mdn",
        "with": {
          "query": "${state.query}",
          "mode": "${state.mode}",
          "lang": "${state.lang}",
          "count": "${state.count}",
          "out_dir": "${state.out_dir}"
        },
        "project": {
          "mode": "/mode",
          "query": "/query",
          "path": "/path",
          "locale": "/locale",
          "count": "/count",
          "url": "/url",
          "results": "/results",
          "written": "/written",
          "out_dir": "/out_dir",
          "page_title": "/page_title",
          "fetched_at": "/fetched_at"
        }
      }
    }
  ]
}
