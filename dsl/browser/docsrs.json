{
  "name": "docsrs_reader",
  "dsl_version": 2,
  "description": "Read docs.rs in a background Chrome tab, driven by the Rhai plugin `websites/docs.rs` (kind: \"plugin\"). --query \"serde\" searches crate releases and returns crate/version/description/released per row; --query \"https://docs.rs/serde/latest/serde/\" (or state crate, mode \"crate\") reads one crate's rendered API docs into Markdown under ~/tmp/docsrs. Optional state: mode (auto|search|crate), count/limit (1-50), out_dir.",
  "start": "read",
  "max_iterations": 2,
  "policy": {
    "allow_exec": true,
    "allow_hosts": [
      "127.0.0.1",
      "docs.rs"
    ],
    "allow_paths": [
      "${env.HOME}/.laya-workflow",
      "${env.HOME}/tmp/docsrs"
    ],
    "max_timeout_ms": 60000,
    "max_output": 4194304,
    "retries": 0
  },
  "capabilities": {
    "chrome": {
      "kind": "chrome_cdp",
      "endpoint": "http://127.0.0.1:9222",
      "launch": true,
      "startup_timeout_ms": 20000,
      "timeout_ms": 20000,
      "max_text": 6000
    },
    "docsrs": {
      "kind": "plugin",
      "plugin": "docsrs",
      "browser": "chrome",
      "timeout_ms": 30000
    }
  },
  "nodes": [
    {
      "name": "read",
      "primary_q": "done",
      "questions": {
        "done": {
          "type": "choice",
          "instructions": "Read the site as requested?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "action": {
        "kind": "call",
        "capability": "docsrs",
        "with": {
          "query": "${state.query}",
          "mode": "${state.mode}",
          "count": "${state.count}"
        },
        "project": {
          "mode": "/mode",
          "query": "/query",
          "count": "/count",
          "url": "/url",
          "page_title": "/page_title",
          "results": "/results",
          "written": "/written",
          "out_dir": "/out_dir",
          "fetched_at": "/fetched_at",
          "crate": "/crate",
          "docs_url": "/docs_url",
          "source": "/source"
        }
      }
    }
  ]
}
