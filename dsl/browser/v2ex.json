{
  "name": "v2ex_reader",
  "dsl_version": 2,
  "description": "Read V2EX in a background Chrome tab, driven by the Rhai plugin `websites/v2ex.com` (kind: \"plugin\"). --query \"hot\" (or latest/tech/creative/play/apple/jobs/deals/city/qna/all) lists that tab; \"go/rust\" (or node:rust) lists a node; a topic id or a /t/<id> URL reads a topic with its replies. Optional state: mode (auto|tab|node|topic), count/limit (1-100).",
  "start": "read",
  "max_iterations": 2,
  "policy": {
    "allow_exec": true,
    "allow_hosts": [
      "127.0.0.1",
      "www.v2ex.com"
    ],
    "allow_paths": [],
    "max_timeout_ms": 60000,
    "max_output": 4194304,
    "retries": 0
  },
  "capabilities": {
    "chrome": {
      "kind": "chrome_cdp",
      "endpoint": "http://127.0.0.1:9222",
      "launch": true,
      "startup_timeout_ms": 20000,
      "timeout_ms": 20000,
      "max_text": 6000
    },
    "v2ex": {
      "kind": "plugin",
      "plugin": "v2ex",
      "browser": "chrome",
      "timeout_ms": 30000
    }
  },
  "nodes": [
    {
      "name": "read",
      "primary_q": "done",
      "questions": {
        "done": {
          "type": "choice",
          "instructions": "Read V2EX as requested?",
          "criteria": { "A": "yes", "B": "no" }
        }
      },
      "edge": { "condition": {}, "default": "STOP" },
      "action": {
        "kind": "call",
        "capability": "v2ex",
        "with": {
          "query": "${state.query}",
          "mode": "${state.mode}",
          "count": "${state.count}"
        },
        "project": {
          "mode": "/mode",
          "feed": "/feed",
          "query": "/query",
          "node": "/node",
          "count": "/count",
          "url": "/url",
          "results": "/results",
          "title": "/title",
          "replies": "/replies",
          "content": "/content",
          "fetched_at": "/fetched_at"
        }
      }
    }
  ]
}
