{
  "name": "github_reader",
  "dsl_version": 2,
  "description": "Read GitHub in a background Chrome tab, driven by the Rhai plugin `websites/github.com` (kind: \"plugin\"). --query \"trending\" (default) lists the day's trending repositories (state since: daily|weekly|monthly, language: e.g. rust) with stars/forks/description; --query \"BurntSushi/ripgrep\" (or a github.com URL) reads one repository — stars, forks, description and its README rendered to Markdown under ~/tmp/github. Optional state: mode (auto|trending|repo), since, language, count/limit (1-50), out_dir.",
  "start": "read",
  "max_iterations": 2,
  "policy": {
    "allow_exec": true,
    "allow_hosts": [
      "127.0.0.1",
      "github.com",
      "raw.githubusercontent.com",
      "user-images.githubusercontent.com",
      "camo.githubusercontent.com",
      "github.githubassets.com",
      "avatars.githubusercontent.com"
    ],
    "allow_paths": [
      "${env.HOME}/.laya-workflow",
      "${env.HOME}/tmp/github"
    ],
    "max_timeout_ms": 60000,
    "max_output": 4194304,
    "retries": 0
  },
  "capabilities": {
    "chrome": {
      "kind": "chrome_cdp",
      "endpoint": "http://127.0.0.1:9222",
      "launch": true,
      "startup_timeout_ms": 20000,
      "timeout_ms": 20000,
      "max_text": 6000
    },
    "github": {
      "kind": "plugin",
      "plugin": "websites/github",
      "browser": "chrome",
      "timeout_ms": 30000
    }
  },
  "nodes": [
    {
      "name": "read",
      "primary_q": "done",
      "questions": {
        "done": {
          "type": "choice",
          "instructions": "Read the site as requested?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "action": {
        "kind": "call",
        "capability": "github",
        "with": {
          "query": "${state.query}",
          "mode": "${state.mode}",
          "count": "${state.count}"
        },
        "project": {
          "mode": "/mode",
          "query": "/query",
          "count": "/count",
          "url": "/url",
          "page_title": "/page_title",
          "results": "/results",
          "written": "/written",
          "out_dir": "/out_dir",
          "fetched_at": "/fetched_at",
          "repo": "/repo",
          "since": "/since",
          "language": "/language",
          "stars": "/stars",
          "forks": "/forks",
          "description": "/description",
          "source": "/source"
        }
      }
    }
  ]
}
