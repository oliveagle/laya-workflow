    "project": {
     "p3_url": "/url",
     "p3_title": "/title",
     "p3_elements": "/elements",
     "p3_sample": "/sample"
    }
   }
  },
  {
   "name": "sweep",
   "primary_q": "go",
   "questions": {
    "go": {
     "type": "choice",
     "instructions": "把第 3 页的 20 张商品卡一个一个打开、读详情、打分排序，选出最推荐的?",
     "criteria": {
      "A": "yes",
      "B": "no"
     }
    }
   },
   "edge": {
