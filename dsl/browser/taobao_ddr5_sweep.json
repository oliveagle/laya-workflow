    "capability": "chrome",
    "chain": [
     {
      "as": "dec",
      "capability": "planner",
      "with": {
       "operation": "CLICK",
       "roles": [
        "button"
       ],
       "match": [
        "下一页"
       ],
       "note": "多页浏览：翻到第 3 页",
       "op": "find",
       "target_id": "${state.browser_target}",
       "retry_ms": 6000,
       "selector": "button[aria-label*=\"下一页\"]"
      }
     }
    ],
    "with": {
     "op": "agent_step",
     "target_id": "${state.browser_target}",
     "decision": "${with.dec}"
    },
    "project": {
     "decision": "/dec",
     "step_action": "/dec/operation",
