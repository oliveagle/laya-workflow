     "step_name": "/dec/name",
     "step_note": "/dec/note",
     "step_rationale": "/dec/rationale",
     "step_href": "/dec/href",
     "step_stayed": "/dec/stayed_in_tab",
     "act": "/result"
    }
   }
  },
  {
   "name": "j_next3",
   "primary_q": "go",
   "questions": {
    "go": {
     "type": "choice",
     "instructions": "Record this round in the tour journal and continue?",
     "criteria": {
      "A": "yes",
      "B": "no"
     }
    }
   },
   "edge": {
    "condition": {
     "A": "observe_p3"
    },
