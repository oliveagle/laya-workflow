{
  "name": "bdd_wait_probe",
  "dsl_version": 2,
  "description": "A hand-written spec that waits for an element that never appears, and is required to FAIL. It exists to hold `bdd.wait_for` to two claims the suite otherwise cannot check: that its budget is milliseconds on both sides of the comparison, and that the failure names the budget and the selector. The first version divided the budget into seconds but counted `waited` in milliseconds, so `100 < 15.0` was already false and it gave up after one poll while claiming a 15s timeout - a wait that lies about how long it waited. laya-workflow bdd run requires a non-zero exit that names the budget, the selector, and a poll count consistent with the budget asked for.",
  "start": "open",
  "max_iterations": 9,
  "convergence_window": 3,
  "convergence_eps": 0.001,
  "policy": {
    "allow_exec": true,
    "allow_hosts": [
      "127.0.0.1",
      "localhost"
    ],
    "max_timeout_ms": 120000,
    "max_output": 1048576,
    "retries": 0
  },
  "capabilities": {
    "chrome": {
      "kind": "chrome_cdp",
      "endpoint": "http://127.0.0.1:${state.cdp_port}",
      "profile_dir": "${state.cdp_profile}",
      "launch": true,
      "startup_timeout_ms": 30000,
      "timeout_ms": 15000,
      "max_text": 8000,
      "max_owned_pages": 32,
      "owned_idle_ms": 300000,
      "chrome_binary": "scripts/bdd/chrome-headless.sh"
    },
    "bdd": {
      "kind": "plugin",
      "plugin": "bdd",
      "browser": "chrome",
      "timeout_ms": 60000
    }
  },
  "nodes": [
    {
      "name": "open",
      "primary_q": "ok",
      "questions": {
        "ok": {
          "type": "choice",
          "instructions": "Open ${state.url} in a real Chrome tab and wait until it is actually loaded?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {
          "A": "wait_forever"
        },
        "default": "STOP"
      },
      "state": {
        "keep": [
          "url",
          "target_id"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "chrome",
        "with": {
          "op": "open",
          "url": "${state.url}"
        },
        "project": {
          "target_id": "/target_id"
        }
      }
    },
    {
      "name": "wait_forever",
      "primary_q": "ok",
      "questions": {
        "ok": {
          "type": "choice",
          "instructions": "Did the element turn up?",
          "criteria": {
            "A": "yes",
            "B": "no"
          }
        }
      },
      "edge": {
        "condition": {
          "A": "STOP"
        },
        "default": "STOP"
      },
      "state": {
        "keep": [
          "url",
          "target_id"
        ]
      },
      "action": {
        "kind": "call",
        "capability": "bdd",
        "with": {
          "op": "wait_for",
          "target_id": "${state.target_id}",
          "selector": "#never-going-to-appear",
          "timeout_ms": 600
        },
        "project": {
          "target_id": "/target_id"
        }
      }
    }
  ]
}
