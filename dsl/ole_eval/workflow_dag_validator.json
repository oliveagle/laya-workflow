{
  "name": "workflow_dag_validator",
  "_bdd": {
    "feature": "workflow_dag_validator",
    "feature_path": "bdd/workflows/ole_eval/workflow_dag_validator.feature",
    "mode": "decision"
  },
  "description": "Guard for LLM-proposed workflow DAGs as a single triage node. The model\nproposes one typed DAG (request_id, workflow_name, nodes [{id, type}], edges\n[{from, to, condition}]); this workflow owns the node/edge caps, the\nacyclicity check, the single-start/single-end checks, the blocked node-type\nset and the dangerous-token scan. Port of\ncode/qwen_vm/app_scenarios/workflow_dag_validator.\nFolding boundaries (documented, not computed in the DSL):\n- JSON parsing details (required fields, node id grammar, unique ids, node\ntype enum, edge endpoints in the node set, condition enum, dangerous-token\nrejection) fold into the `proposal` choice.\n- The DAG policy (max_nodes, max_edges, blocked_node_types, require_approval)\nis a fixed fixture. The structural graph checks (acyclicity, start/end\ncounts) fold into verdict choices.\nEmitted labels: reject_proposal, reject_node_count, reject_edge_count,\nreject_cycle, reject_no_start, reject_multiple_starts, reject_no_end,\nreject_blocked_type, reject_dangerous, escalate_approval, approve.",
  "start": "guard",
  "max_iterations": 5,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "nodes": [
    {
      "name": "guard",
      "primary_q": "acyclic",
      "questions": {
        "proposal": {
          "type": "choice",
          "instructions": "Does the model response parse as exactly one {request_id, workflow_name, nodes [{id, type}], edges [{from, to, condition}]} object with unique valid node ids, endpoint node refs and valid enums?",
          "criteria": {
            "accepted": "exactly one structurally valid DAG",
            "malformed": "parse error, missing field, bad node id, unknown endpoint or bad enum"
          },
          "heuristic": {
            "answer_field": "ev_proposal"
          }
        },
        "node_count": {
          "type": "choice",
          "instructions": "Is the node count within the policy max_nodes cap?",
          "criteria": {
            "ok": "nodes <= max_nodes",
            "over": "nodes > max_nodes"
          },
          "heuristic": {
            "answer_field": "ev_node_count"
          }
        },
        "edge_count": {
          "type": "choice",
          "instructions": "Is the edge count within the policy max_edges cap?",
          "criteria": {
            "ok": "edges <= max_edges",
            "over": "edges > max_edges"
          },
          "heuristic": {
            "answer_field": "ev_edge_count"
          }
        },
        "acyclic": {
          "type": "choice",
          "instructions": "Is the workflow free of cycles?",
          "criteria": {
            "ok": "no cycle",
            "cycle": "a cycle is present"
          },
          "heuristic": {
            "answer_field": "ev_acyclic"
          }
        },
        "start_nodes": {
          "type": "choice",
          "instructions": "How many start-type nodes does the workflow have?",
          "criteria": {
            "one": "exactly one start node",
            "none": "no start node",
            "multiple": "more than one start node"
          },
          "heuristic": {
            "answer_field": "ev_start_nodes"
          }
        },
        "end_nodes": {
          "type": "choice",
          "instructions": "Does the workflow have at least one end-type node?",
          "criteria": {
            "ok": "at least one end node",
            "none": "no end node"
          },
          "heuristic": {
            "answer_field": "ev_end_nodes"
          }
        },
        "blocked_type": {
          "type": "choice",
          "instructions": "Does the workflow avoid all blocked node types?",
          "criteria": {
            "ok": "no blocked node type",
            "blocked": "a blocked node type"
          },
          "heuristic": {
            "answer_field": "ev_blocked_type"
          }
        },
        "dangerous": {
          "type": "choice",
          "instructions": "Is every string field free of dangerous tokens?",
          "criteria": {
            "ok": "no dangerous tokens",
            "found": "some string field is dangerous"
          },
          "heuristic": {
            "answer_field": "ev_dangerous"
          }
        },
        "approval": {
          "type": "choice",
          "instructions": "Does the DAG policy require manual approval before execution?",
          "criteria": {
            "not_required": "no approval flag set",
            "required": "policy require_approval true"
          },
          "heuristic": {
            "answer_field": "ev_approval"
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "action": {
        "kind": "threshold",
        "question": "acyclic",
        "rules": [
          {
            "when": {
              "question": "proposal",
              "answer": "malformed"
            },
            "label": "reject_proposal"
          },
          {
            "when": {
              "question": "node_count",
              "answer": "over"
            },
            "label": "reject_node_count"
          },
          {
            "when": {
              "question": "edge_count",
              "answer": "over"
            },
            "label": "reject_edge_count"
          },
          {
            "when": {
              "question": "acyclic",
              "answer": "cycle"
            },
            "label": "reject_cycle"
          },
          {
            "when": {
              "question": "start_nodes",
              "answer": "none"
            },
            "label": "reject_no_start"
          },
          {
            "when": {
              "question": "start_nodes",
              "answer": "multiple"
            },
            "label": "reject_multiple_starts"
          },
          {
            "when": {
              "question": "end_nodes",
              "answer": "none"
            },
            "label": "reject_no_end"
          },
          {
            "when": {
              "question": "blocked_type",
              "answer": "blocked"
            },
            "label": "reject_blocked_type"
          },
          {
            "when": {
              "question": "dangerous",
              "answer": "found"
            },
            "label": "reject_dangerous"
          },
          {
            "when": {
              "question": "approval",
              "answer": "required"
            },
            "label": "escalate_approval"
          },
          {
            "when": {
              "always": true
            },
            "label": "approve"
          }
        ]
      },
      "state": {
        "keep": [
          "request_id"
        ]
      }
    }
  ]
}
