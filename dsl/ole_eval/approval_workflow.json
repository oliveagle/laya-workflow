{
  "name": "approval_workflow",
  "_bdd": {
    "feature": "approval_workflow",
    "feature_path": "bdd/workflows/ole_eval/approval_workflow.feature",
    "mode": "decision"
  },
  "description": "Multi-role order approval as a finite-state decision graph. The model proposes\nexactly one typed proposal per turn (a role plus an action); this workflow owns\nquorum-by-amount-band, one vote per role, requester self-approval and the\nterminal-state rules. Port of code/qwen_vm/app_scenarios/approval_workflow.\nsubmit folds the amount into a band (small = 0.01..1000.00 manager only;\nmedium = 1000.01..10000.00 manager + finance; large = 10000.01..100000.00\nmanager + finance + security). A rejected proposal ends the episode and the\nworkflow state is unchanged; an accepted proposal advances it.",
  "start": "submitted",
  "max_iterations": 12,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "nodes": [
    {
      "name": "submitted",
      "primary_q": "proposal",
      "questions": {
        "proposal": {
          "type": "choice",
          "instructions": "A new approval request is open and nobody has voted. Classify the utterance into one typed proposal; the band is read from the amount.",
          "criteria": {
            "submit_small": "the requester submits 0.01..1000.00 (manager only)",
            "submit_medium": "the requester submits 1000.01..10000.00 (manager + finance)",
            "submit_large": "the requester submits 10000.01..100000.00 (manager + finance + security)",
            "cancel": "the original requester cancels before any review"
          },
          "heuristic": {
            "answer_field": "ev_submitted"
          }
        }
      },
      "edge": {
        "condition": {
          "submit_small": "await_manager",
          "submit_medium": "await_mgr_fin",
          "submit_large": "await_mfs",
          "cancel": "cancelled"
        },
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "action": {
        "kind": "threshold",
        "question": "proposal",
        "rules": [
          {
            "when": {
              "question": "proposal",
              "answer": "submit_small"
            },
            "label": "start_review"
          },
          {
            "when": {
              "question": "proposal",
              "answer": "submit_medium"
            },
            "label": "start_review"
          },
          {
            "when": {
              "question": "proposal",
              "answer": "submit_large"
            },
            "label": "start_review"
          },
          {
            "when": {
              "question": "proposal",
              "answer": "cancel"
            },
            "label": "cancel_request"
          },
          {
            "when": {
              "always": true
            },
            "label": "reject_proposal"
          }
        ]
      }
    },
    {
      "name": "await_manager",
      "primary_q": "proposal",
      "questions": {
        "proposal": {
          "type": "choice",
          "instructions": "Small-band review: one manager approval already meets quorum. A reject vote fails the request; an extra role, a requester self-vote or anything else is refused.",
          "criteria": {
            "manager_approve": "the manager approves; quorum is met",
            "manager_reject": "the manager rejects the request",
            "extra_role": "finance or security tries to approve, but is not required",
            "requester_attempt": "the requester tries to approve their own request",
            "self_approval": "a reviewer whose actor id is the requester approves"
          },
          "heuristic": {
            "answer_field": "ev_await_manager"
          }
        }
      },
      "edge": {
        "condition": {
          "manager_approve": "approved",
          "manager_reject": "rejected"
        },
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "action": {
        "kind": "threshold",
        "question": "proposal",
        "rules": [
          {
            "when": {
              "question": "proposal",
              "answer": "manager_approve"
            },
            "label": "approve_request"
          },
          {
            "when": {
              "question": "proposal",
              "answer": "manager_reject"
            },
            "label": "reject_request"
          },
          {
            "when": {
              "question": "proposal",
              "answer": "extra_role"
            },
            "label": "role_not_required"
          },
          {
            "when": {
              "question": "proposal",
              "answer": "requester_attempt"
            },
            "label": "requester_cannot_vote"
          },
          {
            "when": {
              "question": "proposal",
              "answer": "self_approval"
            },
            "label": "self_approval_forbidden"
          },
          {
            "when": {
              "always": true
            },
            "label": "reject_proposal"
          }
        ]
      }
    },
