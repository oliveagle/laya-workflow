{
  "name": "order_tracker",
  "_bdd": {
    "feature": "order_tracker",
    "feature_path": "bdd/workflows/ole_eval/order_tracker.feature",
    "mode": "decision"
  },
  "description": "BDD decision workflow: order_tracker",
  "start": "draft",
  "max_iterations": 12,
  "convergence_window": 5,
  "convergence_eps": 0.0001,
  "nodes": [
    {
      "name": "draft",
      "primary_q": "event",
      "questions": {
        "event": {
          "type": "choice",
          "instructions": "The order is a draft. Translate the utterance into exactly one typed lifecycle event; the model only proposes the event, all eligibility and money are computed locally.",
          "criteria": {
            "create": "open a new order",
            "pay": "record that payment was received",
            "pack": "begin fulfilment",
            "ship": "hand the parcel to the carrier",
            "deliver": "mark the parcel delivered",
            "cancel": "cancel the order",
            "refund": "refund a cancelled or delivered order"
          },
          "heuristic": {
            "answer_field": "ev_draft"
          }
        }
      },
      "edge": {
        "condition": {
          "create": "created"
        },
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "action": {
        "kind": "threshold",
        "question": "event",
        "rules": [
          {
            "when": {
              "question": "event",
              "answer": "create"
            },
            "label": "create"
          },
          {
            "when": {
              "always": true
            },
            "label": "reject"
          }
        ]
      }
    },
    {
      "name": "created",
      "primary_q": "event",
      "questions": {
        "event": {
          "type": "choice",
          "instructions": "The order is created and unpaid. pay records payment; cancel is allowed while unpaid. Any other event is illegal from here.",
          "criteria": {
            "create": "open a new order",
            "pay": "record that payment was received",
            "pack": "begin fulfilment",
            "ship": "hand the parcel to the carrier",
            "deliver": "mark the parcel delivered",
            "cancel": "cancel the order",
            "refund": "refund a cancelled or delivered order"
          },
          "heuristic": {
            "answer_field": "ev_created"
          }
        }
      },
      "edge": {
        "condition": {
          "pay": "paid",
          "cancel": "cancelled_unpaid"
        },
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "action": {
        "kind": "threshold",
        "question": "event",
        "rules": [
          {
            "when": {
              "question": "event",
              "answer": "pay"
            },
            "label": "pay"
          },
          {
            "when": {
              "question": "event",
              "answer": "cancel"
            },
            "label": "cancel"
          },
          {
            "when": {
              "always": true
            },
            "label": "reject"
          }
