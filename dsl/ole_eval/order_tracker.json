        "event": {
          "type": "choice",
          "instructions": "The order was cancelled before payment: nothing is refundable, so refund is refused. This state is terminal.",
          "criteria": {
            "create": "open a new order",
            "pay": "record that payment was received",
            "pack": "begin fulfilment",
