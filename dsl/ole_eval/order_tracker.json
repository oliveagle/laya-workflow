        }
      },
      "edge": {
        "condition": {
          "pack": "fulfilling",
          "cancel": "cancelled_paid"
        },
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "action": {
        "kind": "threshold",
        "question": "event",
        "rules": [
          {
            "when": {
              "question": "event",
              "answer": "pack"
            },
            "label": "pack"
          },
          {
            "when": {
              "question": "event",
              "answer": "cancel"
            },
            "label": "cancel"
          },
          {
            "when": {
              "always": true
            },
            "label": "reject"
          }
        ]
      }
    },
