{
  "name": "mlu270_smoke",
  "dsl_version": 2,
  "description": "Port of code/scripts/mlu270-inference-test.sh decision layer. Probe runs the four sub-checks (cntool info / cntoolkit sample inference / torch_mlu import / torch_mlu 1024x4096x1024 matmul+layer_norm+softmax smoke). Decision: any FAIL → FAIL; any WARN → WARN; else PASS. Side effects (cntool / torch_mlu / python on MLU270 hardware) stay in the probe layer.",
  "start": "decision",
  "max_iterations": 2,
  "nodes": [
    {
      "name": "decision",
      "primary_q": "cntool_ok",
      "questions": {
        "cntool_ok": {
          "type": "choice",
          "instructions": "Did cntool enumerate MLU270 devices?",
          "criteria": {
            "A": "cntool OK",
            "B": "cntool missing/failed"
          },
          "heuristic": {
            "match_any": [
              "cntool_missing",
              "cntool_failed",
              "mlu270_not_detected"
            ],
            "p_hit": 0.95,
            "p_miss": 0.05
          }
        },
        "cntoolkit_sample_ok": {
          "type": "choice",
          "instructions": "Did cntoolkit sample inference (matrix multiply on MLU) succeed?",
          "criteria": {
            "A": "sample ran",
            "B": "sample failed"
          },
          "heuristic": {
            "match_any": [
              "cntoolkit_sample_failed",
              "sample_compile_failed"
            ],
            "p_hit": 0.95,
            "p_miss": 0.05
          }
        },
        "torch_mlu_ok": {
          "type": "choice",
          "instructions": "Did torch_mlu import + device probe succeed?",
          "criteria": {
            "A": "import OK",
            "B": "import/device failed"
          },
          "heuristic": {
            "match_any": [
              "torch_mlu_import_failed",
              "torch_mlu_device_failed"
            ],
            "p_hit": 0.95,
            "p_miss": 0.05
          }
        },
        "inference_smoke_ok": {
          "type": "choice",
          "instructions": "Did the matmul+layernorm+softmax smoke run on mlu:0 complete?",
          "criteria": {
            "A": "smoke passed",
            "B": "smoke failed"
          },
          "heuristic": {
            "match_any": [
              "inference_smoke_failed",
              "no_available_runtime"
            ],
            "p_hit": 0.95,
            "p_miss": 0.05
          }
        },
        "driver_warn": {
          "type": "choice",
          "instructions": "Did driver / firmware / torch versions trigger an advisory warn?",
          "criteria": {
            "A": "no advisory",
            "B": "version advisory"
          },
          "heuristic": {
            "match_any": [
              "version_mismatch_warn",
              "driver_advisory"
            ],
            "p_hit": 0.85,
            "p_miss": 0.15
          }
        }
      },
      "edge": {
        "condition": {},
        "default": "STOP"
      },
      "min_confidence": 0.0,
      "action": {
        "kind": "threshold",
        "question": "cntool_ok",
        "rules": [
          {
            "when": {
              "question": "cntool_ok",
              "answer": "B"
            },
            "label": "FAIL"
          },
          {
            "when": {
              "question": "cntoolkit_sample_ok",
              "answer": "B"
            },
            "label": "FAIL"
          },
          {
            "when": {
              "question": "torch_mlu_ok",
              "answer": "B"
            },
            "label": "FAIL"
          },
          {
            "when": {
              "question": "inference_smoke_ok",
              "answer": "B"
            },
            "label": "FAIL"
          },
          {
            "when": {
              "question": "driver_warn",
              "answer": "B"
            },
            "label": "WARN"
          },
          {
            "when": {
              "always": true
            },
            "label": "PASS"
          }
        ]
      },
      "state": {
        "keep": [
          "cntool_missing",
          "cntoolkit_sample_failed",
          "torch_mlu_import_failed",
          "inference_smoke_failed",
          "no_available_runtime",
          "version_mismatch_warn"
        ]
      }
    }
  ]
}
